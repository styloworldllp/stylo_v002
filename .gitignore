# ── Site credentials & runtime data ────────────────────────────────────────
# Exclude all live site directories (contain DBs, credentials, uploads)
sites/*/
# But keep the template/shared config files
!sites/common_site_config.json
!sites/apps.txt
sites/currentsite.txt
sites/.DS_Store

# ── Node modules (rebuild per OS/arch on each machine) ─────────────────────
node_modules/
*/node_modules/
*/frontend/node_modules/
*/desk/node_modules/
*/public/node_modules*/
# Numbered duplicates (macOS creates these on copy)
node_modules[_ ][0-9]*
node_modules [0-9]*

# ── Python virtualenv & compiled files ─────────────────────────────────────
env/
__pycache__/
*.py[cod]
*.pyo
*.egg-info/
dist/
build/

# ── Logs & runtime artifacts ────────────────────────────────────────────────
logs/
*.log

# ── Archived / obsolete directories ─────────────────────────────────────────
archived/

# ── macOS clutter ────────────────────────────────────────────────────────────
.DS_Store
.AppleDouble
.LSOverride
*.mov
*.mp4

# ── Large binaries ────────────────────────────────────────────────────────────
*.dmg
*.iso
*.img
*.zip

# ── macOS duplicate files (created by copy — " 2" in name) ──────────────────
*\ 2/
*\ 2.*
hooks\ 2.md

# ── Build output (regenerated by bench build) ───────────────────────────────
sites/assets/
*.bundle.js
*.bundle.css

# ── Source maps (browser debug files — 124MB, not needed in repo) ────────────
*.js.map
*.css.map

# ── IDE ──────────────────────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
